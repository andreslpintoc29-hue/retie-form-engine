# ============================================
# RETIE INSPECTION PLATFORM - ENVIRONMENT CONFIG
# ============================================

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# Development (Local)
NEXT_PUBLIC_FIREBASE_API_KEY_DEV=your_dev_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN_DEV=your-project-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID_DEV=your-project-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_DEV=your-project-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID_DEV=123456789
NEXT_PUBLIC_FIREBASE_APP_ID_DEV=1:123456789:web:abc123def456

# Staging
NEXT_PUBLIC_FIREBASE_API_KEY_STAGING=your_staging_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN_STAGING=your-project-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID_STAGING=your-project-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_STAGING=your-project-staging.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID_STAGING=123456789
NEXT_PUBLIC_FIREBASE_APP_ID_STAGING=1:123456789:web:abc123def456

# Production
NEXT_PUBLIC_FIREBASE_API_KEY=your_prod_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123def456

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# AUTH CONFIGURATION
# ============================================

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here

# Session Duration (in seconds)
SESSION_DURATION=86400

# ============================================
# FEATURE FLAGS
# ============================================

NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_ATTACHMENTS=true
NEXT_PUBLIC_ENABLE_DIGITAL_SIGNATURES=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ============================================
# STORAGE CONFIGURATION
# ============================================

# Max file sizes (in MB)
MAX_PHOTO_SIZE=10
MAX_VIDEO_SIZE=50
MAX_DOCUMENT_SIZE=25
MAX_SIGNATURE_SIZE=2

# Thumbnail sizes
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200

# Image compression
IMAGE_QUALITY=0.7
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080

# ============================================
# SYNC CONFIGURATION
# ============================================

SYNC_INTERVAL_MS=15000
SYNC_MAX_RETRIES=5
SYNC_RETRY_DELAY_MS=1000
SYNC_MAX_QUEUE_SIZE=500

# ============================================
# PDF CONFIGURATION
# ============================================

PDF_DEFAULT_LANGUAGE=es-CO
PDF_ENABLE_QR_CODE=true
PDF_QR_BASE_URL=https://retie-verify.example.com

# ============================================
# LOGGING & MONITORING
# ============================================

LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Sentry (optional)
# SENTRY_DSN=

# ============================================
# DATABASE (for future use)
# ============================================

# PostgreSQL connection (future)
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Redis (for caching, future)
# REDIS_URL=redis://localhost:6379